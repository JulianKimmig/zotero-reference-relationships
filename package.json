{
  "name": "reference-relationships",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "compile": "node --experimental-strip-types scripts/compile.mts",
    "typecheck": "node --experimental-strip-types scripts/compile.mts --check",
    "build": "npm run compile && node .build/scripts/build.mjs",
    "lint": "npm run typecheck && node --experimental-strip-types scripts/lint.mts",
    "test": "npm run compile && node --test .build/tests/*.test.mjs",
    "test:integration": "npm run compile && node .build/scripts/integration.mjs",
    "test:sync": "npm run compile && node .build/scripts/sync/run.mjs",
    "ci:validate": "npm run compile && node --experimental-strip-types scripts/lint.mts && node --test .build/tests/*.test.mjs",
    "ci:build": "node --experimental-strip-types scripts/build.mts",
    "ci:native": "node .build/scripts/ci/native.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
